# ===========================================
# BARBER MANAGER - Frontend Configuration
# ===========================================
# Copie este arquivo para .env.local e configure as variáveis

# API URL (Backend)
# Em desenvolvimento: http://localhost:3001/api
# Em produção: https://api.seudominio.com/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ===========================================
# CONFIGURAÇÃO PARA PRODUÇÃO
# ===========================================
# 1. Configure NEXT_PUBLIC_API_URL com a URL do backend em produção
# 2. Execute: npm run build && npm run start
