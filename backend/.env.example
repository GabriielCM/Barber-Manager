# ===========================================
# BARBER MANAGER - Backend Configuration
# ===========================================
# Copie este arquivo para .env e configure as variáveis

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

# JWT Authentication
# IMPORTANTE: Gere uma chave segura para produção!
# Use: openssl rand -base64 64
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Application
PORT=3001
NODE_ENV=development

# Frontend URL (obrigatório para CORS em produção)
# Em produção, defina a URL do seu frontend
FRONTEND_URL=http://localhost:3000

# WhatsApp Configuration
WHATSAPP_SESSION_PATH=./whatsapp-session
WHATSAPP_MAX_RETRY_ATTEMPTS=3
NOTIFICATION_BATCH_SIZE=50

# ===========================================
# CONFIGURAÇÃO PARA PRODUÇÃO
# ===========================================
# 1. Mude NODE_ENV para "production"
# 2. Configure DATABASE_URL com credenciais de produção
# 3. Gere um novo JWT_SECRET seguro
# 4. Configure FRONTEND_URL com a URL do seu domínio
# 5. Execute: npm run build && npm run start:prod
